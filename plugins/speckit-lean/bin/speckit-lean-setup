#!/usr/bin/env python3
"""Show or apply the one user setting that speckit-lean cannot set from a plugin.

A plugin may not set `subagentPromptCacheTtl`. This script does it on request.
  speckit-lean-setup           show what would change
  speckit-lean-setup --apply   write the key to ~/.claude/settings.json (backup first)
"""
import json, os, shutil, sys

P = os.path.expanduser("~/.claude/settings.json")
try:
    d = json.load(open(P))
except FileNotFoundError:
    d = {}
cur = d.get("subagentPromptCacheTtl")
print("subagentPromptCacheTtl is currently:", cur if cur else "(not set)")
if cur == "1h":
    print("Nothing to do.")
    sys.exit(0)
if "--apply" not in sys.argv:
    print('Would set "subagentPromptCacheTtl": "1h" in', P, "(run with --apply)")
    sys.exit(0)
if os.path.exists(P):
    shutil.copy(P, P + ".bak-speckit-lean")
d["subagentPromptCacheTtl"] = "1h"
json.dump(d, open(P, "w"), indent=2, ensure_ascii=False)
open(P, "a").write("\n")
print('Set "subagentPromptCacheTtl": "1h". Backup:', P + ".bak-speckit-lean")
